{
  "name": "modding-harness",
  "version": "1.0.0",
  "description": "Specification-driven, verified local development for NeoForge projects",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "prompts",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "mdast-util-from-markdown": "^2.0.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
