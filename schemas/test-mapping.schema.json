{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1,
      "type": "integer"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "unit",
              "gametest"
            ],
            "type": "string"
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "classname": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "acId",
          "type",
          "report",
          "classname",
          "name"
        ]
      }
    }
  },
  "required": [
    "contract",
    "tests"
  ]
}
