{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1,
      "type": "integer"
    },
    "specHash": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]{2,}$"
          },
          "acIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "testStrategy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "acIds",
          "dependsOn",
          "sourceFiles",
          "approach",
          "testStrategy"
        ]
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "acId",
          "reason"
        ]
      }
    }
  },
  "required": [
    "contract",
    "specHash",
    "milestones",
    "blocked"
  ]
}
