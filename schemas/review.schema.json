{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "changes_required"
      ],
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "initialIssue": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ],
            "type": "string"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "requiredChange": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "category",
          "file",
          "lines",
          "reason",
          "requiredChange"
        ]
      }
    }
  },
  "required": [
    "verdict",
    "issues"
  ]
}
