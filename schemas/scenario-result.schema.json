{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1,
      "type": "integer"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "execute",
        "setup",
        "assert"
      ],
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "observed": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "passed",
          "observed"
        ]
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "acId",
          "path"
        ]
      }
    },
    "persistence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "worldId": {
              "type": "string",
              "minLength": 1
            },
            "saved": {
              "type": "boolean"
            },
            "reloaded": {
              "type": "boolean"
            }
          },
          "required": [
            "worldId",
            "saved",
            "reloaded"
          ]
        }
      ]
    },
    "multiplayer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actorClient": {
              "type": "string",
              "minLength": 1
            },
            "observerClient": {
              "type": "string",
              "minLength": 1
            },
            "serverAssertion": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "observed": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "passed",
                "observed"
              ]
            },
            "observerAssertion": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "observed": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "passed",
                "observed"
              ]
            }
          },
          "required": [
            "actorClient",
            "observerClient",
            "serverAssertion",
            "observerAssertion"
          ]
        }
      ]
    }
  },
  "required": [
    "contract",
    "scenarioId",
    "runId",
    "stage",
    "passed",
    "assertions",
    "screenshots",
    "persistence",
    "multiplayer"
  ]
}
