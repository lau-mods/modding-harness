{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "encoding": {
            "enum": [
              "utf8",
              "base64"
            ],
            "type": "string"
          }
        },
        "required": [
          "path",
          "content",
          "encoding"
        ]
      }
    }
  },
  "required": [
    "changes"
  ]
}
