{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1,
      "type": "integer"
    },
    "gradle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compile": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "gameTest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "compile",
        "build",
        "test",
        "gameTest"
      ]
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "model"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "model"
          ]
        }
      },
      "required": [
        "implementation",
        "review"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "mc-pilot",
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "server": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "directory": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "command",
                "directory",
                "address"
              ],
              "additionalProperties": false
            }
          ]
        },
        "deploy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "provider",
        "command",
        "clients",
        "server",
        "deploy",
        "logs"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buildFile": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "buildFile",
        "metadata"
      ]
    }
  },
  "required": [
    "contract",
    "gradle",
    "agents",
    "runtime",
    "project"
  ]
}
