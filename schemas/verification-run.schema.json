{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1,
      "type": "integer"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "specHash": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "acIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "passed": {
      "type": "boolean"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "gate",
          "passed"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acId": {
            "type": "string",
            "minLength": 1
          },
          "specHash": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "unit",
              "gametest",
              "e2e",
              "visual",
              "persistence",
              "multiplayer"
            ],
            "type": "string"
          },
          "result": {
            "const": "passed",
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "acId",
          "specHash",
          "milestone",
          "verification",
          "result",
          "artifacts"
        ]
      }
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "contract",
    "runId",
    "specHash",
    "milestone",
    "acIds",
    "passed",
    "gates",
    "evidence",
    "failure"
  ]
}
